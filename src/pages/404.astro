---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — moizxsec" description="Page not found.">
  <div class="max-w-6xl mx-auto px-6 py-24">
    <div class="font-mono text-sm text-zinc-500 mb-2">$ curl -sI {Astro.url.pathname}</div>
    <div class="font-mono text-sm text-zinc-700 mb-8">HTTP/2 404 Not Found</div>

    <h1 class="text-3xl font-semibold text-zinc-50 tracking-tight mb-4">
      That page doesn't exist.
    </h1>
    <p class="text-zinc-400 leading-relaxed max-w-xl mb-8">
      The link is wrong, the page moved, or the slug was made up. None of those are
      interesting bugs.
    </p>

    <div class="flex gap-4 text-sm font-mono">
      <a
        href="/"
        class="text-zinc-200 underline decoration-zinc-700 underline-offset-2 hover:decoration-orange-500"
        >home</a
      >
      <span class="text-zinc-800">·</span>
      <a
        href="/writeups"
        class="text-zinc-200 underline decoration-zinc-700 underline-offset-2 hover:decoration-orange-500"
        >writeups</a
      >
      <span class="text-zinc-800">·</span>
      <a
        href="mailto:muezzism@gmail.com"
        class="text-zinc-200 underline decoration-zinc-700 underline-offset-2 hover:decoration-orange-500"
        >email</a
      >
    </div>
  </div>
</BaseLayout>
