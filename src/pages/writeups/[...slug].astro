---
import WriteupLayout from '../../layouts/WriteupLayout.astro';
import { getPublished } from '../../lib/writeups';

export async function getStaticPaths() {
  const writeups = await getPublished();
  return writeups.map((w) => ({
    params: { slug: w.slug },
    props: { entry: w },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<WriteupLayout entry={entry} headings={headings}>
  <Content />
</WriteupLayout>
