---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { SITE } from '../../lib/writeups';
import { getProjects, projectLinks } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();
const links = projectLinks(entry);

const meta = [
  ['role', d.role],
  ['status', d.status],
  d.language && ['language', d.language],
  d.license && ['license', d.license],
].filter(Boolean) as [string, string][];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: d.title,
  description: d.summary,
  codeRepository: d.repo,
  programmingLanguage: d.language,
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: SITE.name, url: Astro.site?.toString() },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={`${d.title} | ${SITE.handle}`} description={d.summary} ogType="article" jsonLd={jsonLd}>
  <div class="max-w-site mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16">
    <nav class="font-mono text-xs text-faint mb-8 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
      <a href="/projects/" class="hover:text-fg transition-colors">projects</a>
      <span aria-hidden="true">/</span>
      <span class="text-muted">{entry.slug}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_16rem] gap-10 lg:gap-16">
      <article class="min-w-0 max-w-prose lg:max-w-none">
        <header class="mb-8">
          <div class="flex items-center gap-x-3 gap-y-1.5 mb-4 font-mono text-xs text-faint flex-wrap">
            <span class="chip">{d.role}</span>
            {d.language && <span>{d.language}</span>}
            {d.license && <span>{d.license}</span>}
            <StatusBadge status={d.status} />
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-[2.5rem] font-semibold text-fg leading-[1.15] tracking-tight mb-3 break-words">
            {d.title}
          </h1>
          <p class="font-mono text-sm text-accent mb-5 break-words">{d.tagline}</p>
          <p class="text-muted text-base sm:text-lg leading-relaxed mb-6">{d.summary}</p>

          <div class="flex flex-wrap gap-2">
            {
              links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="btn-ghost">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))
            }
          </div>
        </header>

        <div class="writeup-prose max-w-prose">
          <Content />
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-20 space-y-8">
          <div>
            <div class="label mb-3">Record</div>
            <dl class="font-mono text-xs space-y-2">
              {
                meta.map(([k, v]) => (
                  <div class="flex justify-between gap-3">
                    <dt class="text-faint">{k}</dt>
                    <dd class="text-fg text-right">{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          {
            d.stack.length > 0 && (
              <div>
                <div class="label mb-3">Stack</div>
                <ul class="font-mono text-xs text-muted space-y-1.5">
                  {d.stack.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            )
          }

          <div>
            <div class="label mb-3">Links</div>
            <ul class="space-y-1.5">
              {
                links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class="font-mono text-xs text-muted hover:text-fg transition-colors break-words"
                    >
                      {l.label} <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <a href="#main" class="font-mono text-xs text-faint hover:text-fg transition-colors">↑ back to top</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
