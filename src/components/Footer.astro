---
import { SITE } from '../lib/writeups';
const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-24">
  <div class="max-w-site mx-auto px-4 sm:px-6 py-10 grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-6 text-xs font-mono text-faint">
    <div class="space-y-1.5">
      <div class="text-muted">© {year} {SITE.name} · {SITE.handle}</div>
      <div>All research conducted under authorisation or coordinated disclosure.</div>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 sm:justify-end">
      <li><a href={`mailto:${SITE.email}`} class="hover:text-fg transition-colors">email</a></li>
      <li><a href={SITE.github} target="_blank" rel="noopener" class="hover:text-fg transition-colors">github</a></li>
      <li><a href={SITE.linkedin} target="_blank" rel="noopener" class="hover:text-fg transition-colors">linkedin</a></li>
      <li><a href="/rss.xml" class="hover:text-fg transition-colors">rss</a></li>
      <li><a href="/sitemap-index.xml" class="hover:text-fg transition-colors">sitemap</a></li>
    </ul>
  </div>
</footer>
