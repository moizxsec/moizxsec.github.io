---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** 'sidebar' is the sticky desktop nav; 'inline' is the collapsible mobile block. */
  variant?: 'sidebar' | 'inline';
}

const { headings, variant = 'sidebar' } = Astro.props;
// Astro collects heading text after rehype-autolink-headings has appended its "#",
// so strip that marker before it reaches the nav.
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, '').trim() }))
  .filter((h) => h.text.length > 0);
---

{
  items.length >= 3 &&
    (variant === 'sidebar' ? (
      <nav class="toc" aria-label="Table of contents" data-toc>
        <div class="label mb-3">On this page</div>
        <ol class="list-none m-0 p-0">
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-depth={h.depth}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <details class="toc toc-mobile panel px-4 py-3">
        <summary class="flex items-center justify-between gap-3">
          <span class="label">Contents</span>
          <span class="toc-caret font-mono text-faint text-xs transition-transform" aria-hidden="true">›</span>
        </summary>
        <ol class="list-none m-0 mt-3 p-0">
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-depth={h.depth}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    ))
}
