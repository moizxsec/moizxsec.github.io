---
import type { Severity } from '../lib/writeups';

interface Props {
  severity: Severity;
  /** When given, the score is rendered beside the label: "HIGH 8.7". */
  cvss?: number;
  size?: 'sm' | 'md';
}

const { severity, cvss, size = 'sm' } = Astro.props;
const sizes = {
  sm: 'text-2xs px-1.5 py-0.5 gap-1.5',
  md: 'text-xs px-2 py-1 gap-2',
};
---

<span
  class={`sev inline-flex items-center font-mono font-medium uppercase tracking-wider border rounded whitespace-nowrap ${sizes[size]}`}
  data-sev={severity}
  title={cvss ? `${severity} · CVSS ${cvss.toFixed(1)}` : severity}
>
  <i class="sev-dot inline-block w-1.5 h-1.5 rounded-full" aria-hidden="true"></i>
  <span>{severity}</span>
  {cvss !== undefined && <span class="font-semibold tabular-nums">{cvss.toFixed(1)}</span>}
</span>
