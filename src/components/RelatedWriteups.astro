---
import SeverityBadge from './SeverityBadge.astro';
import { byOrder, getPublished, isoDate } from '../lib/writeups';

interface Props {
  currentSlug: string;
  tags: string[];
  type?: string;
}

const { currentSlug, tags, type } = Astro.props;

// Shared tags weigh most; same type breaks ties; then the author's own ordering.
const all = await getPublished();
const related = all
  .filter((w) => w.slug !== currentSlug)
  .map((w) => ({
    entry: w,
    score: w.data.tags.filter((t) => tags.includes(t)).length * 2 + (w.data.type === type ? 1 : 0),
  }))
  .sort((a, b) => b.score - a.score || byOrder(a.entry, b.entry))
  .slice(0, 3)
  .map((r) => r.entry);
---

{
  related.length > 0 && (
    <section class="reveal border-t border-line pt-8 mt-14" aria-labelledby="related-heading">
      <h2 id="related-heading" class="label mb-4">
        Related
      </h2>
      <ul class="divide-y divide-line">
        {related.map((w) => (
          <li>
            <a href={`/writeups/${w.slug}/`} class="flex items-center gap-3 py-3 group text-sm">
              <time datetime={isoDate(w.data.date)} class="font-mono text-xs text-faint shrink-0 tabular-nums hidden sm:block">
                {isoDate(w.data.date)}
              </time>
              <span class="text-fg group-hover:text-accent transition-colors flex-1 min-w-0 leading-snug">
                {w.data.title}
              </span>
              <span class="shrink-0">
                <SeverityBadge severity={w.data.severity} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
