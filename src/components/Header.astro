---
const { pathname } = Astro.url;
const isActive = (path: string) =>
  pathname === path || (path !== '/' && pathname.startsWith(path));
---

<header class="border-b border-zinc-900 bg-zinc-950/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-baseline gap-2 group">
      <span class="font-mono text-sm text-zinc-50 font-semibold tracking-tight">moizxsec</span>
      <span class="font-mono text-xs text-zinc-600 group-hover:text-zinc-400 transition-colors">/ Abdul Moiz</span>
    </a>
    <nav class="flex items-center gap-6 text-sm">
      <a
        href="/writeups"
        class={`transition-colors ${isActive('/writeups') ? 'text-zinc-50' : 'text-zinc-400 hover:text-zinc-50'}`}
      >
        Writeups
      </a>
      <a
        href="/about"
        class={`transition-colors ${isActive('/about') ? 'text-zinc-50' : 'text-zinc-400 hover:text-zinc-50'}`}
      >
        About
      </a>
      <a
        href="https://github.com/moizxsec"
        target="_blank"
        rel="noopener"
        class="text-zinc-400 hover:text-zinc-50 transition-colors hidden sm:inline"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/muezism101"
        target="_blank"
        rel="noopener"
        class="text-zinc-400 hover:text-zinc-50 transition-colors hidden sm:inline"
      >
        LinkedIn
      </a>
    </nav>
  </div>
</header>
