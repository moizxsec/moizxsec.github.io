---
import SeverityBadge from './SeverityBadge.astro';
import { advisoryId, isAdvisory, isoDate, readingTime, type Writeup } from '../lib/writeups';

interface Props {
  entry: Writeup;
  /** Compact rows drop the summary; used for dense lists. */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const d = entry.data;
const dateStr = isoDate(d.date);
const adv = isAdvisory(entry) ? advisoryId(entry) : null;
const mins = readingTime(entry);
---

<li
  class="writeup-row reveal list-none"
  data-type={d.type}
  data-tags={d.tags.join(' ')}
  data-severity={d.severity}
>
  <a
    href={`/writeups/${entry.slug}/`}
    class="group relative block py-5 sm:py-6 border-b border-line hover:bg-elev/60 transition-colors -mx-4 px-4 sm:-mx-6 sm:px-6"
  >
    {d.featured && <span class="featured-bar absolute left-0 top-5 bottom-5 w-[2px] bg-accent" aria-hidden="true"></span>}

    <div class="flex items-center gap-x-2.5 gap-y-1.5 mb-2 font-mono text-xs text-faint flex-wrap">
      <time datetime={dateStr} class="tabular-nums">{dateStr}</time>
      <span class="chip">{d.type}</span>
      {adv && adv.kind !== 'none' && <span class="text-muted">{adv.id}</span>}
      <span class="text-muted truncate max-w-[14rem] sm:max-w-xs hidden sm:inline">{d.product}</span>
      <span class="ml-auto flex items-center gap-2.5">
        <SeverityBadge severity={d.severity} cvss={d.cvss} />
        <span class="hidden sm:inline tabular-nums">{mins} min</span>
      </span>
    </div>

    <h3 class="text-base sm:text-lg font-semibold text-fg tracking-tight leading-snug group-hover:text-accent transition-colors break-words">
      {d.title}
    </h3>

    {!compact && <p class="mt-1.5 text-sm text-muted leading-relaxed line-clamp-3">{d.summary}</p>}

    {
      !compact && d.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tags">
          {d.tags.slice(0, 6).map((tag) => (
            <li class="font-mono text-2xs text-faint">#{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</li>
