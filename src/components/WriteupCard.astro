---
import SeverityBadge from './SeverityBadge.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  date: Date;
  severity: 'Critical' | 'High' | 'Medium' | 'Low' | 'Informational';
  cvss?: number;
  product: string;
  tags: string[];
  type?: 'Disclosure' | 'Research' | 'Class' | 'Architecture' | 'Incident Response';
  readingTime?: number;
  featured?: boolean;
}

const {
  slug,
  title,
  summary,
  date,
  severity,
  cvss,
  product,
  tags,
  type,
  readingTime,
  featured = false,
} = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
---

<a
  href={`/writeups/${slug}`}
  class={`block group border-b border-zinc-900 py-6 hover:bg-zinc-925/40 -mx-6 px-6 transition-colors ${featured ? 'relative' : ''}`}
>
  {
    featured && (
      <span class="absolute left-0 top-6 bottom-6 w-[2px] bg-orange-600/60" />
    )
  }
  <div class="flex items-center gap-3 mb-2 text-xs font-mono text-zinc-500 flex-wrap">
    <time datetime={dateStr}>{dateStr}</time>
    <span class="text-zinc-800">·</span>
    <span class="text-zinc-400">{product}</span>
    <span class="text-zinc-800">·</span>
    <SeverityBadge severity={severity} />
    {
      cvss && (
        <>
          <span class="text-zinc-800">·</span>
          <span class="text-zinc-500">CVSS {cvss.toFixed(1)}</span>
        </>
      )
    }
    {
      type && (
        <>
          <span class="text-zinc-800">·</span>
          <span class="text-[0.65rem] font-mono uppercase tracking-wider text-zinc-400 border border-zinc-800 rounded px-1.5 py-0.5">
            {type}
          </span>
        </>
      )
    }
    {
      readingTime && (
        <>
          <span class="text-zinc-800">·</span>
          <span class="text-zinc-500">{readingTime} min</span>
        </>
      )
    }
  </div>
  <h3 class="text-lg font-semibold text-zinc-50 mb-1 group-hover:text-orange-300 transition-colors tracking-tight">
    {title}
  </h3>
  <p class="text-sm text-zinc-400 leading-relaxed">{summary}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 5).map((tag) => (
          <span class="text-[0.65rem] font-mono uppercase tracking-wider text-zinc-600 border border-zinc-800 rounded px-1.5 py-0.5">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</a>
